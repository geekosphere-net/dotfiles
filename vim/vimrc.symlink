set nocompatible
set backspace=indent,eol,start
set undofile
set undodir=~/.vim/undo,.
set history=200
set ruler
set showcmd
set incsearch
set hlsearch
syntax on
filetype plugin indent on
set termguicolors
set background=dark
map Q gq
inoremap <C-U> <C-G>u<C-U>
" jump to last cursor position on open
augroup vimrcEx
  au!
  autocmd BufReadPost *
    \ if line("'\"") > 1 && line("'\"") <= line("$") |
    \   exe "normal! g`\"" |
    \ endif
augroup END
colorscheme solarized
set background=dark
